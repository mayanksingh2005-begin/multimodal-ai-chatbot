# Multimodal AI Chatbot Environment Variables

# Database: PostgreSQL connection URL (e.g. postgresql://user:password@localhost:5432/multimodal_chatbot)
# If PostgreSQL is not reachable, the application falls back seamlessly to SQLite for local development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multimodal_chatbot

# AI Model API Keys (Supports Gemini or OpenAI)
# Gemini is recommended for rich native multimodal vision and text reasoning
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_PROVIDER=gemini # 'gemini' or 'openai' or 'demo'

# Web Search (Supports DuckDuckGo zero-key search by default, or Tavily/SerpApi)
SEARCH_API_KEY=

# Speech-to-Text & Text-to-Speech (Optional external keys; built-in gTTS & Web Speech are enabled by default)
STT_API_KEY=
TTS_API_KEY=

# App Configuration
APP_ENV=development
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:5173
